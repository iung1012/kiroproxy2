# ════════════════════════════════════════════════════════════════════════════════
#  kiro-stack — configuração unificada
#  cp .env.example .env   →   edite o .env antes de rodar docker compose up
# ════════════════════════════════════════════════════════════════════════════════

# ── kiro-gateway ─────────────────────────────────────────────────────────────
# [OBRIGATÓRIO] Senha de acesso à API do gateway.
# Todos os clientes devem enviar: Authorization: Bearer <valor>
PROXY_API_KEY=troque-por-uma-senha-forte

# (interno — não exposto diretamente, trafega pelo nginx)

# Região AWS usada na autenticação Kiro
KIRO_REGION=us-east-1

# Simula extended thinking nas respostas
FAKE_REASONING=true
FAKE_REASONING_MAX_TOKENS=4000

# Injeta ferramenta web_search nas respostas
WEB_SEARCH_ENABLED=true

# Corta payload automaticamente se ultrapassar limite da API Kiro
AUTO_TRIM_PAYLOAD=false

# Timeout do primeiro token (segundos) e tentativas
FIRST_TOKEN_TIMEOUT=15
FIRST_TOKEN_MAX_RETRIES=3

# Nível de log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Modo debug: off | errors | all
DEBUG_MODE=off

# ── entrada única (nginx) ────────────────────────────────────────────────────
# Porta pública de acesso a tudo (padrão 80)
# /        → painel kirobug
# /v1/     → API do gateway (OpenAI/Anthropic compat)
# /health  → status do gateway
APP_PORT=80

# ── kirobug ──────────────────────────────────────────────────────────────────
# (interno — não exposto diretamente, trafega pelo nginx)

# Browser usado pelo solver de captcha Turnstile
# Opções: camoufox | chromium | firefox
SOLVER_BROWSER_TYPE=camoufox

# Versão do Camoufox (não altere sem necessidade)
CAMOUFOX_VERSION=135.0.1
CAMOUFOX_RELEASE=beta.24

# ── bridge ────────────────────────────────────────────────────────────────────
# Bearer token da API do kirobug.
# Deixe vazio enquanto o kirobug não tiver senha configurada.
KIROBUG_API_KEY=

# Intervalo de sync em segundos (padrão: 5 minutos)
# O bridge consulta o kirobug e atualiza o accounts.json a cada N segundos.
SYNC_INTERVAL=300
